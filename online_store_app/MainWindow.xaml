<Window x:Class="OnlineStore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Интернет-магазин Связи - Витрина" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="ProductsGrid" Grid.Row="0" AutoGenerateColumns="True" IsReadOnly="True"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="Добавить в корзину" Click="BtnAddToCart_Click" Width="150" Margin="5"/>
            <Button Content="Перейти в корзину" Click="BtnOpenCart_Click" Width="150" Margin="5"/>
            <Button Content="Вход для менеджера" Click="BtnManager_Click" Width="150" Margin="5" Background="LightGray"/>
        </StackPanel>
    </Grid>
</Window>