<Window x:Class="OnlineStore.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление товара" Height="448" Width="860">
    <Grid Margin="10">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Название товара:" Margin="5"/>
            <TextBox x:Name="TxtName" Margin="5"/>

            <TextBlock Text="Категория (ID):" Margin="5"/>
            <TextBox x:Name="TxtCategoryId" Margin="5"/>

            <Button Content="Добавить товар в каталог" Margin="5" Background="LightGreen" Click="BtnAdd_Click"/>
        </StackPanel>
    </Grid>
</Window>
